# --- WhatsApp / Bot ---
# JID du groupe autorisé (ex: 1203...@g.us). Laisser vide pour autoriser tous les groupes en dev.
GROUP_JID=
# Numéro(s) admin au format international sans + (ex: 33612345678). Séparer par des virgules.
ADMIN_NUMBERS=

# --- OpenRouter ---
OPENROUTER_API_KEY=
# Modèle gratuit recommandé sur OpenRouter
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Divers ---
LOG_LEVEL=info
TZ=Europe/Paris
