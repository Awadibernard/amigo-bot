# --- WhatsApp / Bot ---
GROUP_JID=
ADMIN_NUMBERS=
TEST_MODE=false
CONVERSATIONAL_MODE=true

# --- IA : Google Gemini ---
# Clé : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# --- IA paramètres ---
AI_MAX_TOKENS=2048
AI_MAX_PER_USER_PER_HOUR=10
AI_MAX_PER_DAY=400
AI_HISTORY_LENGTH=12
AI_MEM_FACTS_LIMIT=5
AI_SUMMARIZE_EVERY=50
DEBUG_BUFFER_SIZE=300

# --- Modération ---
BLOCK_LINKS=true
BLOCK_MEDIA=false
DELETE_BLOCKED=true

# --- Proactivité ---
PROACTIVE_MODE=true
MAX_PROACTIVE_MESSAGES_PER_DAY=2
WELCOME_NEW_MEMBERS=true
SILENCE_MINUTES=240

# --- Scheduler autonome ---
QUIZ_AUTO=true
DEBAT_AUTO=true
ANNIVERSAIRES_AUTO=true
MAX_QUIZ_AUTO_PER_WEEK=2
MAX_DEBAT_AUTO_PER_WEEK=1

# --- Debug / Dashboard ---
DEBUG=false
DEBUG_AI=false
DEBUG_CONVERSATION=false
LOG_LEVEL=info
DASHBOARD_PORT=3000

# --- Jeux & modération avancée ---
GAMES_ADULT_MODE=false
STICKER_MODERATION=false
STICKER_NSFW_THRESHOLD=0.80
STICKER_VIOLENCE_THRESHOLD=0.80

# --- Addressing (arbitrage IA optionnel) ---
ADDRESSING_AI_ARBITRATION=false
ADDRESSING_CONFIDENCE_THRESHOLD=0.7

TZ=Europe/Paris
