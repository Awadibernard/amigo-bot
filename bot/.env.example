# --- WhatsApp / Bot ---
GROUP_JID=
ADMIN_NUMBERS=
TEST_MODE=false

# --- IA : Google Gemini ---
# Clé : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Modération ---
BLOCK_LINKS=true
BLOCK_MEDIA=false
DELETE_BLOCKED=true

# --- Proactivité (Ayumi parle d'elle-même) ---
PROACTIVE_MODE=true
MAX_PROACTIVE_MESSAGES_PER_DAY=2
WELCOME_NEW_MEMBERS=true

# --- Jeux ---
AUTO_FRIDAY_QUIZ=true

# --- Debug / Dashboard ---
DEBUG=false
DEBUG_AI=false
LOG_LEVEL=info
DASHBOARD_PORT=3000

TZ=Europe/Paris
