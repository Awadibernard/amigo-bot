# --- WhatsApp / Bot ---
GROUP_JID=
# Admin numbers (international, no +). Comma-separated. Ex: 228XXXXXXXX,229XXXXXXXX
ADMIN_NUMBERS=

# --- OpenRouter ---
OPENROUTER_API_KEY=
# Modèle principal (le 1er essayé). Le système tentera plusieurs modèles en fallback.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# --- Modération ---
# Bloquer les médias (images/vidéos/gif/audio/doc). Stickers TOUJOURS autorisés.
BLOCK_MEDIA=false
# Supprimer les messages bloqués (liens, mots interdits). Le bot doit être admin.
DELETE_BLOCKED=true

# --- Debug / Dashboard ---
DEBUG=false
DEBUG_AI=false
LOG_LEVEL=info
DASHBOARD_PORT=3000

TZ=Europe/Paris
