# --- WhatsApp / Bot ---
GROUP_JID=
# Admins : numéros internationaux. Accepte +228..., 228..., 228...@s.whatsapp.net
ADMIN_NUMBERS=

# Mode test : si true, tout le monde peut utiliser les commandes admin
TEST_MODE=false

# --- IA : Google Gemini ---
# Clé: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Modération ---
BLOCK_LINKS=true
# Bloquer images/vidéos/audio/documents. Stickers TOUJOURS autorisés.
BLOCK_MEDIA=false
# Supprimer les messages bloqués (le bot doit être admin du groupe)
DELETE_BLOCKED=true

# --- Debug / Dashboard ---
DEBUG=false
DEBUG_AI=false
LOG_LEVEL=info
DASHBOARD_PORT=3000

TZ=Europe/Paris
